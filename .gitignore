# Dependencies
packages/*/.omo/*
.sisyphus/*
!.sisyphus/rules/
!.sisyphus/rules/**
node_modules/

# Build output
dist/
packages/omo-codex/plugin/skills/

# Platform binaries (built, not committed)
/packages/oh-my-opencode-*/bin/
packages/*/bin/oh-my-opencode
packages/*/bin/oh-my-opencode.exe
packages/*/bin/*.map

# IDE
.idea/
.vscode/
agent-harness.code-workspace
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Lock files (use bun.lockb instead)
package-lock.json
!packages/omo-codex/plugin/package-lock.json
yarn.lock

# Environment
.env
.env.local
test-injection/
notepad.md
oauth-success.html
*.bun-build
.dori-sync/
.dori/
.playwright-mcp/

# Debugging / session artifacts (skill workspace residue)
.debugging
.debug-journal*.md
session-ses_*.md
pr-*.md
plans/
.ulw/
.claude/*
!.claude/skills
!.claude/commands
!.claude/settings.json
.dys/

# Utils output
utils/temp/
utils/models-verbose.json

# cross-project agent mailbox
coordination_notes/
.omo/mailbox-outbox.jsonl
.omo/mailbox-trace.jsonl

# Agent workspace (.omo): this fork TRACKS .omo/ (evidence, notepads, plans, drafts,
# boulder.json, rules). Only ephemeral runtime state stays ignored. These rules are at
# end-of-file so they override earlier global patterns (plans/, *.log). See PROJECT_RULES.
!.omo/plans/
!.omo/plans/**
!.omo/evidence/**/*.log
.omo/run-continuation/
.omo/**/.DS_Store
.omo/ralph-loop.local.md
# transient config-migration artifacts (upstream startup-migration writes these)
.omo/migration-backup-*/
.omo/omo.jsonc.bak.*
.omo/omo.json.bak.*

# Dev-only scratch: QA scripts, PR worktrees, vendored upstream clones. Never committed.
.local-ignore/
# Frontend provenance submodules: unlinked in this fork (see AGENTS.md fork scope policy).
packages/shared-skills/upstreams/
