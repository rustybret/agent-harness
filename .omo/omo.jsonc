// OMO configuration
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    "git_master": {
      "commit_footer": false,
      "git_env_prefix": "GIT_MASTER=1",
      "include_co_authored_by": false
    },
    "cross_project_mailbox": {
      "bounds": {
        "body_digest_ttl_min": 60,
        "max_body_bytes": 64768,
        "max_hops": 4,
        "max_notes_per_drain": 5,
        "reservation_ttl_ms": 120000,
        "same_pair_rate_limit_per_min": 6
      },
      "default_sender_access": "allow-all",
      "enabled": true,
      "intake_eligible_agents": [
        "sisyphus",
        "hephaestus"
      ],
      "interrupt_policy": "allow-interrupt",
      "launch_policy": "auto",
      "senders": {
        "cloudhome-5aa53d2c": {
          "access": "allow",
          "intent_budget": "plan"
        },
        "unitysupermcp-7b6c0482": {
          "access": "allow",
          "intent_budget": "plan"
        },
        "rsg-4abd5985": {
          "access": "allow",
