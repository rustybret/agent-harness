   366	 * if it has none. Gated on the same predicate that injects the envelope
   367	 * instruction, so extraction only expects a tag when the prompt asked for one.
   368	 */
   369	export function getDeliverableTag(agentName: string | undefined): string | undefined {
   370	  return isPlanAgent(agentName) ? PLAN_DELIVERABLE_TAG : undefined
   371	}
   372	
