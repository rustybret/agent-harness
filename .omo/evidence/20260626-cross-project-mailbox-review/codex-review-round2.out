   180	
   181	      const unreadMessages = await listUnreadMessages(latestRuntimeState.teamRunId, latestMemberEntry.name, config)
   182	      if (unreadMessages.length === 0) {
   183	        log("team idle handled without wake hint", {
   184	          event: "team-mode-idle-ack-only",
   185	          teamRunId: latestRuntimeState.teamRunId,
   186	          memberName: latestMemberEntry.name,
   187	          sessionID,
   188	          ackedCount: pendingInjectedMessageIds.length,
   189	        })
   190	        return
   191	      }
   192	
   193	      if (typeof ctx.client.session.promptAsync !== "function") {
   194	        log("team idle wake hint skipped without promptAsync", {
   195	          event: "team-mode-idle-wake-hint-skipped",
   196	          teamRunId: latestRuntimeState.teamRunId,
   197	          memberName: latestMemberEntry.name,
   198	          sessionID,
   199	          unreadCount: unreadMessages.length,
