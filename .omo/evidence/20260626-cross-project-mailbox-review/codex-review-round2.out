     8	import { MessageSchema } from "../types"
     9	import type { Message } from "../types"
    10	
    11	function isInboxMessageFile(entry: Dirent): boolean {
    12	  return entry.isFile() && entry.name.endsWith(".json") && !entry.name.startsWith(".")
    13	}
    14	
    15	function isMissingDirectoryError(error: unknown): error is NodeJS.ErrnoException {
    16	  return error instanceof Error && "code" in error && error.code === "ENOENT"
    17	}
    18	
    19	async function readInboxMessage(
    20	  inboxDir: string,
    21	  fileName: string,
    22	  memberName: string,
    23	  teamRunId: string,
    24	): Promise<Message | null> {
    25	  const filePath = path.join(inboxDir, fileName)
    26	  const messageContext = { memberName, teamRunId, fileName }
    27	
    28	  try {
    29	    const fileContent = await readFile(filePath, "utf8")
    30	    const parsedMessage = MessageSchema.safeParse(JSON.parse(fileContent))
    31	    if (!parsedMessage.success) {
    32	      log("team mailbox skipped malformed message", {
    33	        event: "team-mailbox-malformed-message",
    34	        ...messageContext,
    35	        issues: parsedMessage.error.issues,
    36	      })
    37	      return null
    38	    }
    39	
    40	    return parsedMessage.data
    41	  } catch (error) {
    42	    log("team mailbox skipped unreadable message", {
    43	      event: "team-mailbox-unreadable-message",
    44	      ...messageContext,
    45	      error: error instanceof Error ? error.message : String(error),
    46	    })
    47	    return null
    48	  }
    49	}
    50	
    51	export async function listUnreadMessages(
    52	  teamRunId: string,
    53	  memberName: string,
    54	  config: TeamModeConfig,
    55	): Promise<Message[]> {
    56	  const inboxDir = getInboxDir(resolveBaseDir(config), teamRunId, memberName)
    57	
    58	  try {
    59	    const directoryEntries = await readdir(inboxDir, { withFileTypes: true })
    60	    const unreadMessages = await Promise.all(
    61	      directoryEntries
    62	        .filter(isInboxMessageFile)
    63	        .map((entry) => readInboxMessage(inboxDir, entry.name, memberName, teamRunId)),
    64	    )
    65	
    66	    return unreadMessages
    67	      .filter((message): message is Message => message !== null)
    68	      .sort((leftMessage, rightMessage) => leftMessage.timestamp - rightMessage.timestamp)
    69	  } catch (error) {
    70	    if (isMissingDirectoryError(error)) {
    71	      return []
    72	    }
    73	
    74	    throw error
    75	  }
    76	}
     1	import type { TeamModeConfig } from "../config"
     2	import { loadRuntimeState, transitionRuntimeState } from "../team-state-store/store"
     3	import type { Message } from "../types"
     4	import { listUnreadMessages } from "./inbox"
     5	
     6	export interface InjectionResult {
     7	  injected: boolean
     8	  content?: string
     9	  messageIds: string[]
    10	  reason?: string
    11	}
    12	
    13	function escapeAttributeValue(value: string): string {
    14	  return value
    15	    .replaceAll("&", "&amp;")
    16	    .replaceAll('"', "&quot;")
    17	    .replaceAll("<", "&lt;")
    18	    .replaceAll(">", "&gt;")
    19	    .replaceAll("'", "&apos;")
    20	}
    21	
    22	export function buildEnvelope(message: Message): string {
    23	  const attributes = [
    24	    `from="${escapeAttributeValue(message.from)}"`,
    25	    `timestamp="${escapeAttributeValue(String(message.timestamp))}"`,
    26	    `messageId="${escapeAttributeValue(message.messageId)}"`,
    27	    `kind="${escapeAttributeValue(message.kind)}"`,
    28	    `correlationId="${escapeAttributeValue(message.correlationId ?? "")}"`,
    29	  ]
    30	
    31	  if (message.summary !== undefined) {
    32	    attributes.push(`summary="${escapeAttributeValue(message.summary)}"`)
    33	  }
    34	
    35	  if (message.references !== undefined) {
    36	    attributes.push(`references="${escapeAttributeValue(JSON.stringify(message.references))}"`)
    37	  }
    38	
    39	  return `<peer_message ${attributes.join(" ")}>
    40	${message.body}
    41	</peer_message>`
    42	}
    43	
    44	export async function pollAndBuildInjection(
    45	  sessionID: string,
    46	  memberName: string,
    47	  teamRunId: string,
    48	  config: TeamModeConfig,
    49	  turnMarker: string,
    50	): Promise<InjectionResult> {
    51	  const unreadMessages = await listUnreadMessages(teamRunId, memberName, config)
    52	  let result: InjectionResult | undefined
    53	
    54	  await transitionRuntimeState(teamRunId, (currentRuntimeState) => {
    55	    const runtimeMember = currentRuntimeState.members.find((member) => member.name === memberName)
    56	    if (runtimeMember === undefined) {
    57	      throw new Error(`runtime member not found for session ${sessionID}: ${memberName}`)
    58	    }
    59	
    60	    if (runtimeMember.lastInjectedTurnMarker === turnMarker) {
    61	      result = { injected: false, messageIds: [], reason: "already injected this turn" }
    62	      return currentRuntimeState
    63	    }
    64	
    65	    const pendingMessageIds = new Set(runtimeMember.pendingInjectedMessageIds)
    66	    const injectableMessages = unreadMessages.filter((message) => !pendingMessageIds.has(message.messageId))
    67	    if (injectableMessages.length === 0) {
    68	      result = pendingMessageIds.size > 0
    69	        ? { injected: false, messageIds: [], reason: "pending ack" }
    70	        : { injected: false, messageIds: [], reason: "no unread" }
    71	      return currentRuntimeState
    72	    }
    73	
    74	    const messageIds: string[] = []
    75	    const envelopes: string[] = []
    76	    for (const unreadMessage of injectableMessages) {
    77	      messageIds.push(unreadMessage.messageId)
    78	      envelopes.push(buildEnvelope(unreadMessage))
    79	    }
    80	    result = { injected: true, content: envelopes.join("\n"), messageIds }
    81	
    82	    return {
    83	      ...currentRuntimeState,
    84	      members: currentRuntimeState.members.map((member) => (
    85	        member.name === memberName
    86	          ? {
    87	            ...member,
    88	            lastInjectedTurnMarker: turnMarker,
    89	            pendingInjectedMessageIds: Array.from(new Set([...member.pendingInjectedMessageIds, ...messageIds])),
    90	          }
    91	          : member
    92	      )),
    93	    }
    94	  }, config)
    95	
    96	  if (result === undefined) {
    97	    throw new Error(`mailbox injection claim failed for session ${sessionID}: ${memberName}`)
    98	  }
    99	
   100	  return result
   101	}

