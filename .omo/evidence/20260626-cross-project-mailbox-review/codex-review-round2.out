    69	type ObjectPathPromptInput = {
    70	  readonly path?: { readonly id?: string } | string
    71	  readonly [key: string]: unknown
    72	}
    73	
    74	function hasObjectSessionPath(input: unknown): input is ObjectPathPromptInput & { readonly path: { readonly id: string } } {
    75	  return typeof input === "object"
    76	    && input !== null
    77	    && "path" in input
    78	    && typeof input.path === "object"
    79	    && input.path !== null
    80	    && "id" in input.path
    81	    && typeof input.path.id === "string"
    82	}
    83	
    84	function isObjectPathTypeError(error: unknown): boolean {
    85	  const message = error instanceof Error
    86	    ? error.message
    87	    : typeof error === "string" ? error : ""
    88	  return message.includes('The "path" property must be of type string') && message.includes("got object")
    89	}
    90	
    91	async function dispatchWithPathCompatibility<TInput>(
    92	  dispatch: (dispatchInput: TInput) => Promise<unknown>,
    93	  input: TInput,
    94	): Promise<unknown> {
    95	  try {
    96	    return await dispatch(input)
    97	  } catch (error) {
    98	    if (!isObjectPathTypeError(error) || !hasObjectSessionPath(input)) {
    99	      throw error
   100	    }
   101	
   102	    const retryInput = {
   103	      ...input,
   104	      path: input.path.id,
   105	    } as TInput
   106	    return dispatch(retryInput)
   107	  }
   108	}
   109	
   110	export async function dispatchInternalPrompt<TInput = PromptAsyncInput>(
   111	  args: InternalPromptDispatchArgs<TInput>,
   112	): Promise<InternalPromptDispatchResult> {
   113	  const {
   114	    client,
   115	    sessionID,
   116	    input,
   117	    source,
   118	    settleMs = DEFAULT_SESSION_IDLE_SETTLE_MS,
   119	  } = args
   120	  const dedupeKey = args.dedupeKey ?? createSemanticPromptDedupeKey(input)
   121	  const queueRetryMs = args.queueRetryMs ?? DEFAULT_PROMPT_QUEUE_RETRY_MS
   122	  const postDispatchHoldMs = args.postDispatchHoldMs ?? DEFAULT_PROMPT_ASYNC_POST_DISPATCH_HOLD_MS
   123	  const semanticDedupeHoldMs = args.semanticDedupeHoldMs
   124	    ?? (postDispatchHoldMs > 0 ? DEFAULT_PROMPT_SEMANTIC_DEDUPE_HOLD_MS : 0)
   125	  const dispatchTimeoutMs = args.dispatchTimeoutMs ?? DEFAULT_PROMPT_DISPATCH_TIMEOUT_MS
   126	  const sessionName = args.mode === "async" ? "promptAsync" : "prompt"
   127	  const resolved = tryResolveDispatchClientSync(args.client, sessionID)
   128	    ?? await resolveDispatchClient(args.client, sessionID)
   129	  const dispatch = (() => {
   130	    if (args.mode === "async") {
   131	      const resolvedAsAsync = resolved.client as PromptAsyncClient<TInput>
   132	      const session = resolvedAsAsync.session
   133	      if (typeof session?.promptAsync !== "function") {
   134	        return undefined
   135	      }
   136	      const dispatchPromptAsync = session.promptAsync.bind(session)
   137	      if (resolved.route === "live") {
