   148	            await requeuePendingLiveDeliveries(runtimeState.teamRunId, memberEntry.name, requeuedMessageIds, config)
   149	          }
   150	          log("team idle handled pending live delivery ack", {
   151	            event: "team-mode-idle-pending-ack",
   152	            teamRunId: runtimeState.teamRunId,
   153	            memberName: memberEntry.name,
   154	            sessionID,
   155	            ackedCount: ackedMessageIds.length,
   156	            requeuedCount: requeuedMessageIds.length,
   157	          })
   158	        }
   159	      }
   160	
   161	      const latestRuntimeState = await loadRuntimeState(runtimeMember.teamRunId, config)
   162	      const latestMemberEntry = latestRuntimeState.members.find((member) => member.name === runtimeMember.memberName)
   163	      if (!latestMemberEntry) {
   164	        return
   165	      }
   166	      if (
   167	        latestMemberEntry.status === "errored"
   168	        || latestMemberEntry.status === "completed"
   169	        || latestMemberEntry.status === "shutdown_approved"
   170	      ) {
   171	        log("team idle wake hint skipped because member is no longer idle", {
   172	          event: "team-mode-idle-member-not-idle",
   173	          teamRunId: latestRuntimeState.teamRunId,
   174	          memberName: latestMemberEntry.name,
