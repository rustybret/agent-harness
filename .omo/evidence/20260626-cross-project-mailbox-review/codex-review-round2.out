   374	 * Plan family: plan + prometheus. Shares mutual delegation blocking and task tool permission.
   375	 * Does NOT share system prompt (only isPlanAgent controls that).
   376	 */
   377	export const PLAN_FAMILY_NAMES = ["plan", "prometheus"]
   378	
   379	/**
   380	 * Check if the given agent belongs to the plan family (blocking + task permission).
   381	 */
   382	export function isPlanFamily(category: string): boolean
   383	export function isPlanFamily(category: string | undefined): boolean
   384	export function isPlanFamily(category: string | undefined): boolean {
   385	  if (!category) return false
   386	  const lowerCategory = getAgentConfigKey(category).toLowerCase().trim()
   387	  return PLAN_FAMILY_NAMES.some((name) => lowerCategory === name)
   388	}
   389	
   390	/**
   391	 * Coordinator/meta agents that own the orchestration loop and must not be used as
   392	 * arbitrary subagent targets via task(). Delegating to these creates duplicate
   393	 * orchestration and conflicting team state (issue #4027).
   394	 *
   395	 * Scoped to AGENT_ELIGIBILITY_REGISTRY hard-reject entries only — sisyphus and atlas
   396	 * are explicitly marked `verdict: "eligible"` for team membership in the registry
   397	 * (src/features/team-mode/types.ts), so they are NOT included here. Adding them would
   398	 * conflict with the team-mode resolver's intentional `allowPrimaryAgentDelegation: true`
   399	 * opt-in.
   400	 *
   401	 * Symmetric guard to the caller-eligibility check added by PR #4065 for team_create.
   402	 */
   403	export const COORDINATOR_AGENT_NAMES = ["prometheus"]
   404	
   405	/**
   406	 * Returns true when the given agent name refers to a coordinator/meta agent that
   407	 * should not be reachable as a subagent_type target via task().
   408	 */
   409	export function isCoordinatorAgent(agentName: string | undefined): boolean {
   410	  if (!agentName) return false
   411	  const normalized = getAgentConfigKey(agentName).toLowerCase().trim()
   412	  return COORDINATOR_AGENT_NAMES.some((name) => normalized === name)
   413	}

