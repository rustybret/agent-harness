   101	    const sessionID = getIdleSessionID(event.properties)
   102	    if (!sessionID) return
   103	
   104	    try {
   105	      const runtimeMember = await findResolvedMemberSession(sessionID, config, "team idle wake hint")
   106	      if (runtimeMember === null) {
   107	        return
   108	      }
   109	
   110	      const runtimeState = await loadRuntimeState(runtimeMember.teamRunId, config)
   111	      const memberEntry = runtimeState.members.find((member) => member.name === runtimeMember.memberName)
   112	      if (!memberEntry) {
   113	        return
   114	      }
   115	
   116	      const pendingInjectedMessageIds = [...memberEntry.pendingInjectedMessageIds]
   117	      if (pendingInjectedMessageIds.length > 0) {
   118	        if (typeof ctx.client.session.status === "function") {
   119	          await settleAfterSessionIdle(options?.idleSettleMs ?? 0)
   120	          if (await isSessionActive(ctx.client, sessionID)) {
