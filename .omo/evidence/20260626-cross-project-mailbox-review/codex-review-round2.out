    34	
    35	export function createMonitorToolsRecord(args: {
    36	  readonly pluginConfig: OhMyOpenCodeConfig
    37	  readonly ctx: PluginContext
    38	  readonly managers: Pick<Managers, "monitorManager">
    39	  readonly factories: ToolRegistryFactories
    40	}): Record<string, ToolDefinition> {
    41	  const { pluginConfig, ctx, managers, factories } = args
    42	  if (!pluginConfig.monitor?.enabled || !managers.monitorManager) return {}
    43	  return factories.createMonitorTools(managers.monitorManager, Object.assign({}, ctx, { pluginConfig }))
    44	}
    45	
    46	export function getTaskSystemEnabled(pluginConfig: OhMyOpenCodeConfig): boolean {
    47	  return isTaskSystemEnabled(pluginConfig)
    48	}

