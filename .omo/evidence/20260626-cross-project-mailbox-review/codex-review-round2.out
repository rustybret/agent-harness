   124	              memberName: memberEntry.name,
   125	              sessionID,
   126	              pendingCount: pendingInjectedMessageIds.length,
   127	            })
   128	            return
   129	          }
   130	        }
   131	
   132	        const claimedMessageIds = await claimPendingMessageAcks(
