   147	    throw new BroadcastNotPermittedError()
   148	  }
   149	
   150	  const baseDir = resolveBaseDir(config)
   151	  const deliveredTo: string[] = []
   152	  const reservedRecipients = context.reservedRecipients ?? new Set<string>()
   153	
   154	  for (const recipient of resolveRecipients(message, context)) {
   155	    const inboxDir = getInboxDir(baseDir, teamRunId, recipient)
   156	    await mkdir(inboxDir, { recursive: true, mode: 0o700 })
