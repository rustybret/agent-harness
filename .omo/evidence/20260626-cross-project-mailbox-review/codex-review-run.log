     1	#!/usr/bin/env bash
     2	# QA isolation helper. SOURCE this file (do not execute it) to export a
     3	# throwaway OpenCode + Codex environment so QA never reads or writes your real
     4	# host config:
     5	#
     6	#   source script/agent/qa-sandbox.sh
     7	#
     8	# It mirrors the opencode-qa (oqa_mk_isolated_xdg) and codex-qa (isolated
     9	# CODEX_HOME) skill conventions: every path lands under a fresh mktemp dir, so
    10	# the running machine's ~/.config/opencode and ~/.codex are untouched. Remove
    11	# the sandbox afterwards with: rm -rf "$OMO_QA_ROOT"
    12	#
    13	# Intentionally does NOT set -e: sourcing must not change the caller's shell.
    14	
    15	OMO_QA_ROOT="$(mktemp -d -t omo-qa-sandbox.XXXXXX)"
    16	export OMO_QA_ROOT
    17	
    18	# OpenCode: isolated XDG dirs (never the host ~/.config or ~/.local/share).
    19	export XDG_DATA_HOME="$OMO_QA_ROOT/data"
    20	export XDG_CONFIG_HOME="$OMO_QA_ROOT/config"
    21	export XDG_CACHE_HOME="$OMO_QA_ROOT/cache"
    22	export XDG_STATE_HOME="$OMO_QA_ROOT/state"
    23	mkdir -p "$XDG_DATA_HOME" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_STATE_HOME"
    24	export OPENCODE_DISABLE_AUTOUPDATE=1
    25	export OPENCODE_DISABLE_MODELS_FETCH=1
    26	
    27	# Codex: isolated CODEX_HOME (must exist before codex runs, or it hard-errors).
    28	export CODEX_HOME="$OMO_QA_ROOT/codex"
    29	mkdir -p "$CODEX_HOME"
    30	
    31	# Credentials, set once: inject keys from the gitignored .env (see .env.example).
    32	# ${BASH_SOURCE[0]:-$0} resolves this file under both bash and zsh (sourced $0).
    33	_omo_self="${BASH_SOURCE[0]:-$0}"
    34	_omo_repo_root="$(cd "$(dirname "$_omo_self")/../.." && pwd)"
    35	if [ -f "$_omo_repo_root/.env" ]; then
    36	  case "$-" in *a*) _omo_had_allexport=1 ;; *) _omo_had_allexport=0 ;; esac
    37	  set -a
    38	  # shellcheck disable=SC1091
    39	  . "$_omo_repo_root/.env"
    40	  [ "$_omo_had_allexport" = "1" ] || set +a
    41	  unset _omo_had_allexport
    42	fi
    43	unset _omo_self _omo_repo_root
    44	
    45	printf '[qa-sandbox] isolated env ready under %s\n' "$OMO_QA_ROOT"
    46	printf '[qa-sandbox]   XDG_CONFIG_HOME=%s\n' "$XDG_CONFIG_HOME"
    47	printf '[qa-sandbox]   CODEX_HOME=%s\n' "$CODEX_HOME"
    48	printf '[qa-sandbox] host ~/.config/opencode and ~/.codex are untouched. Clean up: rm -rf "%s"\n' "$OMO_QA_ROOT"

