   291	function renderPlanAgentCategoryRows(categories: AvailableCategory[]): string[] {
   292	  const sorted = [...categories].sort((a, b) => a.name.localeCompare(b.name))
   293	  return sorted.map((category) => {
   294	    const bestFor = category.description || category.name
   295	    const model = category.model || ""
   296	    return `| \`${category.name}\` | ${bestFor} | ${model} |`
   297	  })
   298	}
   299	
   300	function renderPlanAgentSkillRows(skills: AvailableSkill[]): string[] {
   301	   const sorted = [...skills].sort((a, b) => a.name.localeCompare(b.name))
   302	   return sorted.map((skill) => {
   303	     const domain = truncateDescription(skill.description).trim() || skill.name
   304	     return `| \`${skill.name}\` | ${domain} |`
   305	   })
   306	 }
   307	
   308	export function buildPlanAgentSkillsSection(
   309	  categories: AvailableCategory[] = [],
   310	  skills: AvailableSkill[] = []
   311	): string {
   312	  const categoryRows = renderPlanAgentCategoryRows(categories)
   313	  const skillRows = renderPlanAgentSkillRows(skills)
   314	
   315	  return `### AVAILABLE CATEGORIES
   316	
   317	| Category | Best For | Model |
   318	|----------|----------|-------|
   319	${categoryRows.join("\n")}
   320	
   321	### AVAILABLE SKILLS (ALWAYS EVALUATE ALL)
   322	
   323	Skills inject specialized expertise into the delegated agent.
   324	YOU MUST evaluate EVERY skill and justify inclusions/omissions.
   325	
   326	| Skill | Domain |
   327	|-------|--------|
   328	${skillRows.join("\n")}`
   329	}
   330	
   331	export function buildPlanAgentSystemPrepend(
   332	  categories: AvailableCategory[] = [],
   333	  skills: AvailableSkill[] = []
   334	): string {
   335	  return [
   336	    PLAN_AGENT_SYSTEM_PREPEND_STATIC_BEFORE_SKILLS,
   337	    buildPlanAgentSkillsSection(categories, skills),
   338	    PLAN_AGENT_SYSTEM_PREPEND_STATIC_AFTER_SKILLS,
   339	  ].join("\n\n")
   340	}
