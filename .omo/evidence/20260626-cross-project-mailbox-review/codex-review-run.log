   342	/**
   343	 * List of agent names that should be treated as plan agents (receive plan system prompt).
   344	 * Case-insensitive matching is used.
   345	 */
   346	export const PLAN_AGENT_NAMES = ["plan"]
   347	
   348	/**
   349	 * Check if the given agent name is a plan agent (receives plan system prompt).
   350	 */
   351	export function isPlanAgent(agentName: string | undefined): boolean {
   352	  if (!agentName) return false
   353	  const lowerName = getAgentConfigKey(agentName).toLowerCase().trim()
   354	  return PLAN_AGENT_NAMES.some(name => lowerName === name)
   355	}
   356	
   357	/**
   358	 * Envelope tag the plan agent wraps its final deliverable in (`<plan>...</plan>`).
   359	 * Injected into the plan system prompt and read back by fetchSyncResult so the
   360	 * deliverable turn is selected explicitly rather than by recency.
   361	 */
   362	export const PLAN_DELIVERABLE_TAG = "plan"
   363	
   364	/**
   365	 * Resolve the deliverable envelope tag an agent is expected to emit, or undefined
   366	 * if it has none. Gated on the same predicate that injects the envelope
   367	 * instruction, so extraction only expects a tag when the prompt asked for one.
   368	 */
   369	export function getDeliverableTag(agentName: string | undefined): string | undefined {
   370	  return isPlanAgent(agentName) ? PLAN_DELIVERABLE_TAG : undefined
   371	}
