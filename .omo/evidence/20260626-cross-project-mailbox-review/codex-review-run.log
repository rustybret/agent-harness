    86	    output: ChatMessageHandlerOutput,
    87	  ): Promise<void> => {
    88	    if (isSyntheticOrInternalOnlyTextParts(output.parts)) {
    89	      log("[chat-message] Skipping synthetic/internal-only message", {
    90	        sessionID: input.sessionID,
    91	      })
    92	      return
