   131	export async function sendMessage(
   132	  message: Message,
   133	  teamRunId: string,
   134	  config: TeamModeConfig,
   135	  context: SendContext,
   136	): Promise<{ messageId: string; deliveredTo: string[] }> {
   137	  const serializedMessage = `${JSON.stringify(message, null, 2)}\n`
   138	  const serializedMessageBytes = Buffer.byteLength(serializedMessage, "utf8")
   139	  const payloadBytes = Buffer.byteLength(message.body, "utf8")
   140	  if (payloadBytes > config.message_payload_max_bytes) {
