    39	async function listSourceFiles(directory: string): Promise<string[]> {
    40	  const entries = await readdir(directory, { withFileTypes: true })
    41	  const nestedFiles = await Promise.all(entries.map(async (entry) => {
    42	    const entryPath = path.join(directory, entry.name)
    43	    if (entry.isDirectory()) {
    44	      return listSourceFiles(entryPath)
    45	    }
    46	    if (
    47	      entry.isFile()
    48	      && entry.name.endsWith(".ts")
    49	      && !entry.name.endsWith(".test.ts")
    50	      && !entry.name.endsWith(".d.ts")
    51	    ) {
    52	      return [entryPath]
    53	    }
    54	    return []
    55	  }))
    56	
    57	  return nestedFiles.flat()
    58	}
