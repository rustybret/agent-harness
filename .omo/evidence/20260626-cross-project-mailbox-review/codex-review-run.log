   310	export function releasePromptAsyncReservation(
   311	  sessionID: string,
   312	  source: string,
   313	  options?: PromptAsyncReservationReleaseOptions,
   314	): boolean {
   315	  const existing = getPromptReservation(sessionID)
   316	  if (!existing) {
   317	    return false
   318	  }
   319	
   320	  const expectedSource = options?.reservedBy ?? source
   321	  if (!reservationSourceMatches(existing.source, expectedSource, options?.reservedByPrefix)) {
   322	    log("[prompt-async-gate] promptAsync reservation release skipped for different source", {
   323	      sessionID,
   324	      source,
   325	      reservedBy: existing.source,
   326	    })
   327	    return false
   328	  }
   329	
   330	  deletePromptReservation(sessionID)
   331	  deleteRecentPromptDispatch(sessionID, existing.dedupeKey)
   332	  releaseInFlightPromptMatchingDedupe(sessionID, existing.dedupeKey)
   333	  schedulePromptQueueDrain(sessionID, 0)
   334	  log("[prompt-async-gate] promptAsync reservation released", {
   335	    sessionID,
   336	    source,
   337	    reservedBy: existing.source,
   338	  })
   339	  return true
   340	}

